# Yardhand: every setting, explained. None is needed to start: `docker compose up -d`, then open the app
# and follow the setup. Copy this file to .env for what you want to change. Keep .env private.

# ── Keys. All optional: a new instance makes its own and keeps them in instance.json beside its data ──

# Seals every stored credential (32 random bytes, base64). Set here, it wins over the one in instance.json.
# Back it up: without it they are lost, and a backup restores only where the same one is set.
GATEWAY_MASTER_KEY=

# More owners, as `name:<sha256 of the key>`. The owner who claimed the instance in the browser is kept in
# instance.json; the keys themselves are never stored.
API_KEYS=

# Signs the tokens of agents that connect with OAuth (claude.ai connectors).
OAUTH_SIGNING_KEY=

# ── Where it is reached ──

# The address people and agents use; the gateway hands it out in links and OAuth redirects.
# A bare name means HTTPS (gateway.example.test, with `--profile https` or your own proxy);
# write a plain-HTTP address whole: http://nas.local:8080.
# Empty: http://localhost:<GATEWAY_PORT>
PUBLIC_HOST=

# The port on this machine.
# Empty: 8080
GATEWAY_PORT=

# Who can reach that port: 127.0.0.1 is this machine only (and Caddy, with `--profile https`);
# 0.0.0.0 opens it to your network.
# Empty: 127.0.0.1
GATEWAY_BIND=

# The image to run. Empty: the release this compose file came with.
# Empty: ghcr.io/escalay/yardhand:<this release>
GATEWAY_IMAGE=

# ── Optional parts. Settings in the app shows which are on ──

# Tool search by meaning, not only by words (an OpenRouter key).
OPENROUTER_API_KEY=

# Posts a note when a third-party tool change waits for your review.
DISCORD_WEBHOOK_URL=

# A Composio CLI user key: a personal Composio connection reads its tool list with it.
COMPOSIO_API_KEY=

# Call traces in Langfuse: metadata only, never arguments or results. Needs both keys.
# Empty: https://cloud.langfuse.com
GATEWAY_LANGFUSE_URL=
GATEWAY_LANGFUSE_PUBLIC_KEY=
GATEWAY_LANGFUSE_SECRET_KEY=

# ── Smart grouping: a model sorts each connection’s tools into groups. Settings › AI can set all of this too ──

# Where the models run: openrouter, openai, local, custom.
# Empty: openrouter
GATEWAY_AI_GROUPING_PROVIDER=

# Its API key. Empty: groups come from naming rules.
GATEWAY_AI_GROUPING_KEY=

# For `local` and `custom`: the OpenAI-compatible API, ending /v1.
GATEWAY_AI_GROUPING_BASE_URL=

# The model that names groups.
GATEWAY_AI_GROUPING_WRITER_MODEL=

# The model that files each tool in a group.
GATEWAY_AI_GROUPING_DECIDER_MODEL=

# How the decider is asked: typesafe (TypeSafe’s decision API) or openai (a chat model).
GATEWAY_AI_GROUPING_DECIDER_PROTOCOL=

# ── Usage telemetry: once a day, an anonymous report of ranges and yes/no answers. docs/telemetry.md lists it all ──

# `off` sends nothing. Settings shows the exact report either way.
# Empty: on
GATEWAY_TELEMETRY=

# `1` also switches it off, as in other tools.
DO_NOT_TRACK=

# Where reports go: your own collector, for a fork or a fleet.
# Empty: https://pulse.escalay.space/v1/yardhand
GATEWAY_TELEMETRY_URL=

# ── Sign-in by Cloudflare Access instead of the owner key (both, or neither) ──

# Your Zero Trust team name.
ACCESS_TEAM=

# The Access application’s audience tag.
ACCESS_AUD=
