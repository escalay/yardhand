{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.md",
      "!**/.release-please-manifest.json",
      "!**/deploy/helm/**/templates",
      "!**/src/kit",
      "!**/src/guide.gen.ts",
      "!**/.state",
      "!**/tools.gen.ts",
      "!**/routeTree.gen.ts",
      "!**/src/api/schema.d.ts",
      "!**/src/ui/shadcn",
      "!**/public/illustrations",
      "!**/test-results",
      "!**/playwright-report",
      "!**/e2e/.demo-*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["RadioGroupItem", "Checkbox", "Switch", "Input", "Textarea"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
